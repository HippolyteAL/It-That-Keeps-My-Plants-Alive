{
    "name": "SHT31 Simulator",
    "author": "Hippolyte Audet-Lagace",
    "pins": [
        "VCC",
        "GND",
        "SDA",
        "SCL"
    ],
    "controls": [
        {
        "id": "temperature",
        "label": "Temperature (°C)",
        "type": "range",
        "min": -40,
        "max": 125,
        "step": 1
        },
        {
        "id": "humidity",
        "label": "Humidity (%RH)",
        "type": "range",
        "min": 0,
        "max": 100,
        "step": 1
        }
    ]
}